{
  "name": "package.json",
  "version": "0.0.1",
  "description": "Deterministic web retriever for AI agents — core package",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./openai": {
      "import": "./dist/integrations/openai.js",
      "types": "./dist/integrations/openai.d.ts"
    },
    "./gemini": {
      "import": "./dist/integrations/gemini.js",
      "types": "./dist/integrations/gemini.d.ts"
    },
    "./anthropic": {
      "import": "./dist/integrations/anthropic.js",
      "types": "./dist/integrations/anthropic.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "htmlparser2": "^9.1.0",
    "@mozilla/readability": "^0.5.0",
    "domhandler": "^5.0.3",
    "css-select": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@mozilla/readability": "^0.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4",
    "@vitest/coverage-v8": "^2.0.4",
    "eslint": "^9.7.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0"
  },
  "optionalDependencies": {
    "unpdf": "^0.11.0"
  }
}
