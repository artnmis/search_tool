        policy.ts

      discovery/
        sitemap.ts
        feeds.ts
        links.ts
        metadata.ts
        structured-data.ts
        application-data.ts

      formats/
        html.ts
        xml.ts
        json.ts
        text.ts
        markdown.ts
        pdf.ts          # optional adapter boundary
        image.ts

      extraction/
        readability.ts
        structured.ts
        passages.ts
        tables.ts

      ranking/
        tokenizer.ts
        bm25.ts
        url-score.ts
        source-score.ts
        dedupe.ts

      resolution/
